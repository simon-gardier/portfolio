		<section
			class="home-section section-content prose prose-neutral dark:prose-invert max-w-none"
		>
			<h3 class="text-xl font-bold text-fg-dark m-0">Bio</h3>
			<p class="leading-relaxed">
				I earned a Bachelor's and Master's degree in <a href="https://www.programmes.uliege.be/cocoon/20252026/en/programmes/A2SSYS02_S.html" rel="noopener noreferrer">Computer Science (specialization: “Intelligent Systems”)</a>
				from the <a href="https://www.uliege.be/" rel="noopener noreferrer">University of Liège</a> (ULiège), Belgium.
				During my studies, I joined <a href="https://42belgium.be/en/" rel="noopener noreferrer">School 42</a> in Brussels.
				I was part of the <a href="https://robocup.uliege.be/" rel="noopener noreferrer">RoboCup team at the Montefiore Institute</a> (ULiège),
				where I worked on a biped robot built from the ground up by students. One notable contribution is the development of a bootloader software for the robot's servos.
				The project is under the supervision of <a href="https://people.montefiore.uliege.be/boigelot/" rel="noopener noreferrer">Prof. Bernard Boigelot</a>.
			</p>
			<p class="leading-relaxed">
				My master's thesis on 3D reconstruction and Novel View Synthesis using feed-forward Gaussian Splatting Networks was conducted in collaboration
				with <a href="https://evs.com/eu" rel="noopener noreferrer">EVS Broadcast Equipment</a> (Grade: 17/20).
				Previously, I interned at <a href="https://www.toyota-europe.com/about-us/toyota-in-europe/toyota-motor-europe" rel="noopener noreferrer">Toyota Motor Europe</a> to work on
				the personalization of <a href="https://arxiv.org/abs/2603.09771" rel="noopener noreferrer">Large Vision Language Models</a> under the supervision of
				<a href="https://scholar.google.com/citations?user=YLh7yrwAAAAJ&hl=en" rel="noopener noreferrer">Rahaf AlJundi</a> and
				<a href="https://scholar.google.com/citations?user=JmQOYvQAAAAJ&hl=en" rel="noopener noreferrer">Soroush Seifi</a>.
			</p>
			<p class="leading-relaxed">
				Currently, I am located in Belgium (Europe).
				Please check out my <a href="/projects">Projects</a> and <a href="/blog">Blog</a>, and feel free to reach out at
				<i>gardiersimon dot dev at gmail dot com</i> :)
			</p>
		</section>

		{
			latestPost && (
				<section class="home-section section-content">
					<h3 class="text-xl font-bold text-fg-dark tracking-wider">
						Latest Blog
					</h3>
					<a
						href={`/blog/${latestPost.id}`}
						class="group block p-4 border border-border hover:border-sky-500/30 rounded-xl hover:bg-neutral-50/50 dark:hover:bg-neutral-800/10 no-underline transition-all duration-300"
					>
						<div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-y-1">
							<h5 class="text-base font-bold text-fg-dark group-hover:text-sky-500 transition-colors my-0">
								{latestPost.data.title}
							</h5>
							<span class="text-xs font-mono text-fg-light">
								{new Date(
									latestPost.data.publishedAt,
								).toLocaleDateString("en-US", {
									month: "short",
									day: "numeric",
									year: "numeric",
								})}
							</span>
						</div>
						<p class="text-sm text-fg-light mt-2 mb-0 line-clamp-2">
							{latestPost.data.description}
						</p>
					</a>
				</section>
			)
		}

		<section
			class="home-section section-content prose prose-neutral dark:prose-invert max-w-none"
		>
			<h3 class="text-xl font-bold text-fg-dark m-0">Acknowledgments</h3>
			<p>The following projects have been important to the creation of this website:</p>
			<ul>
				<li><a href="https://zxh.me/">https://zxh.me/</a>, an open-source portfolio, from which the structure and tech stack of this website is heavily inspired.</li>
				<li><a href="https://craftpix.net/freebies/ocean-and-clouds-free-pixel-art-backgrounds/">https://craftpix.net/freebies/ocean-and-clouds-free-pixel-art-backgrounds/</a> from which the pixel-art of the hero component at the top of this page comes from.</li>
				<li style={{ cursor: "url('/hero/cursor.png'), pointer" }}><a href="https://www.magnific.com/icon/wind_12414771">https://www.magnific.com</a> from which the wind cursor comes from.</li>
			</ul>
		</section>
		</div>
	</main>
	</div>
</BaseLayout>

<script>
	const home = document.querySelector<HTMLElement>("[data-home-page]");
	const intro = document.querySelector<HTMLElement>("[data-home-intro]");
	const scene = document.querySelector<HTMLElement>("[data-hero-scene]");

	if (home && intro && scene) {
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let frame = 0;
		let lastProgress = -1;
		let initialPositionSet = false;
		const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
		const shouldSetInitialPosition = !location.hash && navigation?.type !== "back_forward";

		const updateScene = () => {
			frame = 0;
			const heroHeight = scene.offsetHeight;
			const revealDistance = Math.max(1, heroHeight - intro.offsetHeight);
			const progress = Math.min(1, Math.max(0, -home.getBoundingClientRect().top / revealDistance));
			if (progress === lastProgress) return;
			lastProgress = progress;
			scene.style.setProperty("--hero-offset", `${-progress * heroHeight * 0.04}px`);
			scene.style.setProperty("--hero-blur", `${progress * 6}px`);
		};

		const queueUpdate = () => {
			if (!frame && !reducedMotion.matches) frame = requestAnimationFrame(updateScene);
		};

		// Match the overlap to the real introduction, including wrapped text and font changes.
		const introObserver = new ResizeObserver(() => {
			home.style.setProperty("--intro-peek", `${intro.getBoundingClientRect().height}px`);
			if (!initialPositionSet && shouldSetInitialPosition && window.scrollY === 0) {
				initialPositionSet = true;
				requestAnimationFrame(() => window.scrollTo(0, intro.getBoundingClientRect().height));
			}
			lastProgress = -1;
			queueUpdate();
		});
		introObserver.observe(intro);

		const handleMotionPreference = () => {
			cancelAnimationFrame(frame);
			frame = 0;
			lastProgress = -1;
			if (reducedMotion.matches) {
				scene.style.removeProperty("--hero-offset");
				scene.style.removeProperty("--hero-blur");
			} else {
				queueUpdate();
			}
		};

		window.addEventListener("scroll", queueUpdate, { passive: true });
		window.addEventListener("resize", queueUpdate, { passive: true });
		reducedMotion.addEventListener("change", handleMotionPreference);
		queueUpdate();
	}
</script>
