---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroContainer from "../components/HeroContainer.astro";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const latestPost = sortedPosts[0];
---

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	.home-page {
		--intro-peek: 14rem;
		position: relative;
		isolation: isolate;
	}

	.hero-stage {
		position: sticky;
		top: 0;
		height: max(100dvh, calc(var(--intro-peek) + 8rem));
		z-index: 0;
		overflow: hidden;
	}

	.hero-scene {
		height: 100%;
		transform: translate3d(0, var(--hero-offset, 0px), 0) scale(1.06);
		transform-origin: center top;
		filter: blur(var(--hero-blur, 0px));
	}

	.content-sheet {
		display: flow-root;
		position: relative;
		z-index: 1;
		border-radius: 1rem 1rem 0 0;
		background: linear-gradient(
			to bottom,
			transparent var(--intro-peek),
			hsl(var(--bg)) var(--intro-peek)
		);
		box-shadow: 0 -18px 60px rgb(15 23 42 / 0.16);
		clip-path: inset(-60px 0 0 0);
		scroll-margin-top: 6rem;
	}

	.content-sheet::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: calc(var(--intro-peek) + 1px);
		border-radius: inherit;
		border-top: 1px solid hsl(var(--fg) / 0.1);
		background: linear-gradient(
			to bottom,
			hsl(var(--bg) / 0.88),
			hsl(var(--bg) / 0.97) 55%,
			hsl(var(--bg))
		);
		-webkit-backdrop-filter: blur(18px);
		backdrop-filter: blur(18px);
		pointer-events: none;
	}

	.home-section {
		margin: 0;
		padding-block: 2rem;
	}

	.section-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.section-content > * {
		margin-block: 0;
	}

	.home-intro {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.intro-portrait {
		width: 8rem;
		height: 8rem;
	}

	@media (max-width: 639px) {
		.home-page {
			--intro-peek: 12.5rem;
		}

		.home-intro {
			gap: 1rem;
		}

		.intro-portrait {
			width: 5rem;
			height: 5rem;
		}
	}

	@keyframes smooth-blink {
		0%, 100% {
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
	}
	.animate-smooth-blink {
		animation: smooth-blink 2s linear infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}

		.hero-stage {
			position: relative;
		}

		.hero-scene {
			transform: none;
			filter: none;
		}

		.animate-smooth-blink {
			animation: none;
		}
	}
</style>

<BaseLayout
	title="Simon Gardier - Computer Scientist"
	description="Simon Gardier - Computer Scientist, computer vision, embedded systems, and machine learning."
	activePage="home"
	fullWidth={true}
	type="profile"
	structuredData={{
		"@context": "https://schema.org",
		"@type": "Person",
		name: "Simon Gardier",
		url: "https://sgardier.xyz/",
		image: "https://sgardier.xyz/images/profile/profile.jpeg",
		jobTitle: "Computer Scientist",
		description: "Computer Scientist, computer vision, embedded systems, and machine learning.",
		address: { "@type": "PostalAddress", addressCountry: "BE" },
		sameAs: [
			"https://github.com/simon-gardier",
			"https://www.linkedin.com/in/simon-gardier/",
			"https://scholar.google.com/citations?user=OuG3N-EAAAAJ&hl=en",
		],
	}}
>
	<div class="home-page" data-home-page>
	<section class="hero-stage" aria-label="Pixel-art cloud landscape">
		<div class="hero-scene" data-hero-scene>
			<HeroContainer />
		</div>
	</section>

	<main class="content-sheet" id="main_index">
